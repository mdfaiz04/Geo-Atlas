{
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,alembic/**,alembic.ini,.env.example}"
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
